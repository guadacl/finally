<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_KanbanCard"
                  targetNamespace="http://finallyapp.com/bpmn"
                  exporter="FinAlly Camunda agent" exporterVersion="1.0"
                  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">

  <!--
    FinAlly kanban card lifecycle. One process instance per kanban card.
    Variables: cardId (string, correlation key), ticker, column (SUPPORT|RESISTANCE), targetPrice (number), price (number).
    Messages (correlation key = cardId): card-moved {column, targetPrice}, target-price-hit {price},
    card-deleted {ticker, column, targetPrice, userId}.
    Every in-app notification (toast) is sent by a service task of job type "finally-notify"; the notification type
    is given by the task header "notificationType". Card created (both column gateway branches), card deleted and
    target-price hit then fork with a PARALLEL gateway into "Send email" (job type "email-notify") and "Send SMS"
    (job type "sms-notify"), same header, and join again before continuing / ending. Both go through the
    notification MCP server (mcp/email-mcp-server, tools send_email / send_sms). Card moved is toast only.
  -->

  <bpmn:message id="Message_CardDeleted" name="card-deleted">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=cardId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_TargetPriceHit" name="target-price-hit">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=cardId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_CardMoved" name="card-moved">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=cardId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:process id="kanban-card" name="FinAlly kanban card" isExecutable="true">

    <bpmn:startEvent id="StartEvent_CardCreated" name="Card created">
      <bpmn:outgoing>Flow_ToColumnGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_Column" name="Column?" default="Flow_Resistance">
      <bpmn:incoming>Flow_ToColumnGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Support</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resistance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_NotifyCreatedSupport" name="Notify: card created in Support">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finally-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_CREATED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Support</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedSupportToSplit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_SplitCreatedSupport" name="Email and SMS">
      <bpmn:incoming>Flow_CreatedSupportToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedSupportToEmail</bpmn:outgoing>
      <bpmn:outgoing>Flow_CreatedSupportToSms</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_EmailCreatedSupport" name="Send email: card created in Support">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_CREATED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreatedSupportToEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedSupportEmailToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SmsCreatedSupport" name="Send SMS: card created in Support">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sms-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_CREATED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreatedSupportToSms</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedSupportSmsToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_JoinCreatedSupport">
      <bpmn:incoming>Flow_CreatedSupportEmailToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_CreatedSupportSmsToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_SupportToMerge</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_NotifyCreatedResistance" name="Notify: card created in Resistance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finally-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_CREATED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resistance</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedResistanceToSplit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_SplitCreatedResistance" name="Email and SMS">
      <bpmn:incoming>Flow_CreatedResistanceToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedResistanceToEmail</bpmn:outgoing>
      <bpmn:outgoing>Flow_CreatedResistanceToSms</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_EmailCreatedResistance" name="Send email: card created in Resistance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_CREATED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreatedResistanceToEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedResistanceEmailToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SmsCreatedResistance" name="Send SMS: card created in Resistance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sms-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_CREATED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreatedResistanceToSms</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedResistanceSmsToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_JoinCreatedResistance">
      <bpmn:incoming>Flow_CreatedResistanceEmailToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_CreatedResistanceSmsToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ResistanceToMerge</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_SupportToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ResistanceToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWaitDeleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- card-deleted carries the card's last ticker / column / targetPrice / userId (read before the DB row is removed) -->
    <bpmn:intermediateCatchEvent id="Event_CardDeleted" name="Card deleted">
      <bpmn:incoming>Flow_ToWaitDeleted</bpmn:incoming>
      <bpmn:outgoing>Flow_DeletedToNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CardDeleted" messageRef="Message_CardDeleted" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_NotifyCardDeleted" name="Notify: card deleted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finally-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_DELETED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DeletedToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_CardDeletedToSplit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_SplitCardDeleted" name="Email and SMS">
      <bpmn:incoming>Flow_CardDeletedToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_CardDeletedToEmail</bpmn:outgoing>
      <bpmn:outgoing>Flow_CardDeletedToSms</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_EmailCardDeleted" name="Send email: card deleted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_DELETED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CardDeletedToEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_CardDeletedEmailToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SmsCardDeleted" name="Send SMS: card deleted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sms-notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="CARD_DELETED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CardDeletedToSms</bpmn:incoming>
      <bpmn:outgoing>Flow_CardDeletedSmsToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_JoinCardDeleted">
      <bpmn:incoming>Flow_CardDeletedEmailToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_CardDeletedSmsToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_CardDeleted" name="Card removed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToColumnGateway" sourceRef="StartEvent_CardCreated" targetRef="Gateway_Column" />
    <bpmn:sequenceFlow id="Flow_Support" name="SUPPORT" sourceRef="Gateway_Column" targetRef="Task_NotifyCreatedSupport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=column = "SUPPORT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resistance" name="RESISTANCE" sourceRef="Gateway_Column" targetRef="Task_NotifyCreatedResistance" />
    <bpmn:sequenceFlow id="Flow_CreatedSupportToSplit" sourceRef="Task_NotifyCreatedSupport" targetRef="Gateway_SplitCreatedSupport" />
    <bpmn:sequenceFlow id="Flow_CreatedSupportToEmail" sourceRef="Gateway_SplitCreatedSupport" targetRef="Task_EmailCreatedSupport" />
    <bpmn:sequenceFlow id="Flow_CreatedSupportToSms" sourceRef="Gateway_SplitCreatedSupport" targetRef="Task_SmsCreatedSupport" />
    <bpmn:sequenceFlow id="Flow_CreatedSupportEmailToJoin" sourceRef="Task_EmailCreatedSupport" targetRef="Gateway_JoinCreatedSupport" />
    <bpmn:sequenceFlow id="Flow_CreatedSupportSmsToJoin" sourceRef="Task_SmsCreatedSupport" targetRef="Gateway_JoinCreatedSupport" />
    <bpmn:sequenceFlow id="Flow_SupportToMerge" sourceRef="Gateway_JoinCreatedSupport" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_CreatedResistanceToSplit" sourceRef="Task_NotifyCreatedResistance" targetRef="Gateway_SplitCreatedResistance" />
    <bpmn:sequenceFlow id="Flow_CreatedResistanceToEmail" sourceRef="Gateway_SplitCreatedResistance" targetRef="Task_EmailCreatedResistance" />
    <bpmn:sequenceFlow id="Flow_CreatedResistanceToSms" sourceRef="Gateway_SplitCreatedResistance" targetRef="Task_SmsCreatedResistance" />
    <bpmn:sequenceFlow id="Flow_CreatedResistanceEmailToJoin" sourceRef="Task_EmailCreatedResistance" targetRef="Gateway_JoinCreatedResistance" />
    <bpmn:sequenceFlow id="Flow_CreatedResistanceSmsToJoin" sourceRef="Task_SmsCreatedResistance" targetRef="Gateway_JoinCreatedResistance" />
    <bpmn:sequenceFlow id="Flow_ResistanceToMerge" sourceRef="Gateway_JoinCreatedResistance" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToWaitDeleted" sourceRef="Gateway_Merge" targetRef="Event_CardDeleted" />
    <bpmn:sequenceFlow id="Flow_DeletedToNotify" sourceRef="Event_CardDeleted" targetRef="Task_NotifyCardDeleted" />
    <bpmn:sequenceFlow id="Flow_CardDeletedToSplit" sourceRef="Task_NotifyCardDeleted" targetRef="Gateway_SplitCardDeleted" />
    <bpmn:sequenceFlow id="Flow_CardDeletedToEmail" sourceRef="Gateway_SplitCardDeleted" targetRef="Task_EmailCardDeleted" />
    <bpmn:sequenceFlow id="Flow_CardDeletedToSms" sourceRef="Gateway_SplitCardDeleted" targetRef="Task_SmsCardDeleted" />
    <bpmn:sequenceFlow id="Flow_CardDeletedEmailToJoin" sourceRef="Task_EmailCardDeleted" targetRef="Gateway_JoinCardDeleted" />
    <bpmn:sequenceFlow id="Flow_CardDeletedSmsToJoin" sourceRef="Task_SmsCardDeleted" targetRef="Gateway_JoinCardDeleted" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Gateway_JoinCardDeleted" targetRef="EndEvent_CardDeleted" />

    <!-- Live price reached the target: non-interrupting, may fire many times during the card's life. -->
    <bpmn:subProcess id="EventSub_TargetPriceHit" name="Target price hit" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_TargetPriceHit" name="target-price-hit" isInterrupting="false">
        <bpmn:outgoing>Flow_TargetHitToNotify</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_TargetPriceHit" messageRef="Message_TargetPriceHit" />
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_NotifyTargetHit" name="Notify: target price hit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="finally-notify" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="notificationType" value="TARGET_HIT" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TargetHitToNotify</bpmn:incoming>
        <bpmn:outgoing>Flow_TargetHitToSplit</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:parallelGateway id="Gateway_SplitTargetHit" name="Email and SMS">
        <bpmn:incoming>Flow_TargetHitToSplit</bpmn:incoming>
        <bpmn:outgoing>Flow_TargetHitToEmail</bpmn:outgoing>
        <bpmn:outgoing>Flow_TargetHitToSms</bpmn:outgoing>
      </bpmn:parallelGateway>

      <bpmn:serviceTask id="Task_EmailTargetHit" name="Send email: target price hit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="email-notify" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="notificationType" value="TARGET_HIT" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TargetHitToEmail</bpmn:incoming>
        <bpmn:outgoing>Flow_TargetHitEmailToJoin</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="Task_SmsTargetHit" name="Send SMS: target price hit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="sms-notify" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="notificationType" value="TARGET_HIT" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TargetHitToSms</bpmn:incoming>
        <bpmn:outgoing>Flow_TargetHitSmsToJoin</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:parallelGateway id="Gateway_JoinTargetHit">
        <bpmn:incoming>Flow_TargetHitEmailToJoin</bpmn:incoming>
        <bpmn:incoming>Flow_TargetHitSmsToJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_TargetHitToEnd</bpmn:outgoing>
      </bpmn:parallelGateway>

      <bpmn:endEvent id="EndEvent_TargetHitNotified" name="Alert sent">
        <bpmn:incoming>Flow_TargetHitToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_TargetHitToNotify" sourceRef="StartEvent_TargetPriceHit" targetRef="Task_NotifyTargetHit" />
      <bpmn:sequenceFlow id="Flow_TargetHitToSplit" sourceRef="Task_NotifyTargetHit" targetRef="Gateway_SplitTargetHit" />
      <bpmn:sequenceFlow id="Flow_TargetHitToEmail" sourceRef="Gateway_SplitTargetHit" targetRef="Task_EmailTargetHit" />
      <bpmn:sequenceFlow id="Flow_TargetHitToSms" sourceRef="Gateway_SplitTargetHit" targetRef="Task_SmsTargetHit" />
      <bpmn:sequenceFlow id="Flow_TargetHitEmailToJoin" sourceRef="Task_EmailTargetHit" targetRef="Gateway_JoinTargetHit" />
      <bpmn:sequenceFlow id="Flow_TargetHitSmsToJoin" sourceRef="Task_SmsTargetHit" targetRef="Gateway_JoinTargetHit" />
      <bpmn:sequenceFlow id="Flow_TargetHitToEnd" sourceRef="Gateway_JoinTargetHit" targetRef="EndEvent_TargetHitNotified" />
    </bpmn:subProcess>

    <!-- Card moved / target edited: message variables (column, targetPrice) update the process variables. -->
    <bpmn:subProcess id="EventSub_CardMoved" name="Card moved" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_CardMoved" name="card-moved" isInterrupting="false">
        <bpmn:outgoing>Flow_MovedToNotify</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_CardMoved" messageRef="Message_CardMoved" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_NotifyCardMoved" name="Notify: card moved">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="finally-notify" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="notificationType" value="CARD_MOVED" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_MovedToNotify</bpmn:incoming>
        <bpmn:outgoing>Flow_MovedToEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_CardMovedNotified" name="Move notified">
        <bpmn:incoming>Flow_MovedToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_MovedToNotify" sourceRef="StartEvent_CardMoved" targetRef="Task_NotifyCardMoved" />
      <bpmn:sequenceFlow id="Flow_MovedToEnd" sourceRef="Task_NotifyCardMoved" targetRef="EndEvent_CardMovedNotified" />
    </bpmn:subProcess>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_KanbanCard">
    <bpmndi:BPMNPlane id="BPMNPlane_KanbanCard" bpmnElement="kanban-card">
      <bpmndi:BPMNShape id="StartEvent_CardCreated_di" bpmnElement="StartEvent_CardCreated">
        <dc:Bounds x="152" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Column_di" bpmnElement="Gateway_Column" isMarkerVisible="true">
        <dc:Bounds x="235" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCreatedSupport_di" bpmnElement="Task_NotifyCreatedSupport">
        <dc:Bounds x="340" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SplitCreatedSupport_di" bpmnElement="Gateway_SplitCreatedSupport">
        <dc:Bounds x="500" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EmailCreatedSupport_di" bpmnElement="Task_EmailCreatedSupport">
        <dc:Bounds x="590" y="30" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SmsCreatedSupport_di" bpmnElement="Task_SmsCreatedSupport">
        <dc:Bounds x="590" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinCreatedSupport_di" bpmnElement="Gateway_JoinCreatedSupport">
        <dc:Bounds x="750" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCreatedResistance_di" bpmnElement="Task_NotifyCreatedResistance">
        <dc:Bounds x="340" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SplitCreatedResistance_di" bpmnElement="Gateway_SplitCreatedResistance">
        <dc:Bounds x="500" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EmailCreatedResistance_di" bpmnElement="Task_EmailCreatedResistance">
        <dc:Bounds x="590" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SmsCreatedResistance_di" bpmnElement="Task_SmsCreatedResistance">
        <dc:Bounds x="590" y="450" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinCreatedResistance_di" bpmnElement="Gateway_JoinCreatedResistance">
        <dc:Bounds x="750" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="840" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_CardDeleted_di" bpmnElement="Event_CardDeleted">
        <dc:Bounds x="930" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCardDeleted_di" bpmnElement="Task_NotifyCardDeleted">
        <dc:Bounds x="1010" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SplitCardDeleted_di" bpmnElement="Gateway_SplitCardDeleted">
        <dc:Bounds x="1170" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EmailCardDeleted_di" bpmnElement="Task_EmailCardDeleted">
        <dc:Bounds x="1260" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SmsCardDeleted_di" bpmnElement="Task_SmsCardDeleted">
        <dc:Bounds x="1260" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinCardDeleted_di" bpmnElement="Gateway_JoinCardDeleted">
        <dc:Bounds x="1420" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CardDeleted_di" bpmnElement="EndEvent_CardDeleted">
        <dc:Bounds x="1512" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EventSub_TargetPriceHit_di" bpmnElement="EventSub_TargetPriceHit" isExpanded="true">
        <dc:Bounds x="160" y="600" width="760" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_TargetPriceHit_di" bpmnElement="StartEvent_TargetPriceHit">
        <dc:Bounds x="200" y="712" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyTargetHit_di" bpmnElement="Task_NotifyTargetHit">
        <dc:Bounds x="290" y="690" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SplitTargetHit_di" bpmnElement="Gateway_SplitTargetHit">
        <dc:Bounds x="450" y="705" width="50" height="50" />
      </bpmndi:BPMNShape>
