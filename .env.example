# Copy to .env and fill in.

# Required for AI chat (unless LLM_MOCK=true)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Finnhub API key for free real-time US quotes (https://finnhub.io). Takes priority over Massive.
FINNHUB_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data. Empty -> built-in simulator.
MASSIVE_API_KEY=

# true -> deterministic mock LLM responses (tests, no API key needed)
LLM_MOCK=false

# Postgres (used by the postgres and app services)
POSTGRES_DB=finally
POSTGRES_USER=finally
POSTGRES_PASSWORD=finally

# Host port for the app (container always listens on 8000)
APP_PORT=8000

# Camunda host ports (change if another Camunda already uses 26500 / 8081 on this machine)
CAMUNDA_GRPC_HOST_PORT=26500
CAMUNDA_WEB_HOST_PORT=8081

# false -> skip Camunda; notifications are still pushed directly to the browser
FINALLY_WORKFLOW_ENABLED=true

# Keycloak login & registration (http://localhost:8180, admin console at /admin)
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Shared secret between Keycloak client "finally-app" and the app; change it for anything beyond local dev
KEYCLOAK_CLIENT_SECRET=finally-dev-secret
# false -> no login, everyone uses the single "default" user (tests / runs without Keycloak)
AUTH_ENABLED=true
# "Sign in with Google / Facebook" on the Keycloak login page (setup: keycloak/README.md "Social login").
# Leave a pair empty to hide that button; username/password login always works.
# After changing them on an existing Keycloak run keycloak/scripts/apply-social-idps.sh (or .ps1).
# Google Cloud Console OAuth client (Web); redirect URI http://localhost:8180/realms/finally/broker/google/endpoint
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=
# Meta for Developers app (Facebook Login); redirect URI http://localhost:8180/realms/finally/broker/facebook/endpoint
KEYCLOAK_FACEBOOK_CLIENT_ID=
KEYCLOAK_FACEBOOK_CLIENT_SECRET=

# Kanban emails: the card owner gets an email (to the email address of their Keycloak account) when a
# Support / Resistance card is created, deleted, or hits its target (not when it is moved). Toasts are sent either way.
# Path: Camunda "email-notify" task -> app -> MCP tool send_email on the email-mcp service -> SMTP.
# Default (MAIL_HOST not set): the bundled Mailpit catch-all - nothing leaves your machine, read the emails at
# http://localhost:8025. To deliver real emails, uncomment ONE provider block below and fill in your own credentials.
# false -> never send emails
MAIL_ENABLED=true
# Email MCP server endpoint used by the app (compose default http://email-mcp:3001/mcp; empty outside Docker = no emails)
#EMAIL_MCP_URL=

# --- SMTP used by the email-mcp service (any provider; unset -> mailpit:1025) ---
# MAIL_FROM must be a sender address/domain you have VERIFIED at your provider, otherwise it rejects the mail.
#
# SendGrid (user is the literal word "apikey", password is your API key):
#MAIL_HOST=smtp.sendgrid.net
#MAIL_PORT=587
#MAIL_STARTTLS=true
#MAIL_USERNAME=apikey
#MAIL_PASSWORD=<your SendGrid API key>
#MAIL_FROM=Tradex <alerts@your-verified-domain.com>
#
# Brevo (formerly Sendinblue; login and SMTP key from "SMTP & API" in the Brevo console):
#MAIL_HOST=smtp-relay.brevo.com
#MAIL_PORT=587
#MAIL_STARTTLS=true
#MAIL_USERNAME=<your Brevo SMTP login>
#MAIL_PASSWORD=<your Brevo SMTP key>
#MAIL_FROM=Tradex <alerts@your-verified-domain.com>
#
# Mailgun (SMTP credentials of your sending domain):
#MAIL_HOST=smtp.mailgun.org
#MAIL_PORT=587
#MAIL_STARTTLS=true
#MAIL_USERNAME=postmaster@mg.your-domain.com
#MAIL_PASSWORD=<your Mailgun SMTP password>
#MAIL_FROM=Tradex <alerts@mg.your-domain.com>
#
# Implicit TLS instead of STARTTLS (port 465): MAIL_PORT=465 (MAIL_SECURE=true is then the default).
#MAIL_SECURE=
#
# Defaults when not set: no SMTP login, MAIL_STARTTLS=false, MAIL_FROM=Tradex <alerts@finally.local>.
# Keep each MAIL_* variable defined only once in this file (a later empty line would override your value).
# Base URL used for the link in the email (default http://localhost:${APP_PORT})
#APP_PUBLIC_URL=
# Mailpit host ports (web UI / SMTP)
MAILPIT_WEB_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
